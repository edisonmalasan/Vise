{
  "productName": "Vise Transcoder",
  "version": "0.1.0",
  "identifier": "com.vise.transcoder",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vise Transcoder",
        "width": 1100,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "externalBin": [],
    "category": "Video",
    "shortDescription": "Transcode video and audio",
    "longDescription": "Vise Transcoder converts video and audio between formats."
  }
}
