{
  "productName": "Vise Transcoder",
  "version": "0.1.0",
  "identifier": "com.vise.transcoder",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vise Transcoder",
        "width": 1100,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "vendor/ffmpeg/staged/": "media/",
      "vendor/sidecar/vise-worker.exe": "vise-worker.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "externalBin": []
  }
}
