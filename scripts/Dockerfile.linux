# Build environment for a Linux release of Vise.
#
# The desktop application is a webview, so packaging it needs the webview toolkit
# and the libraries its runtime links against. These are named explicitly rather
# than pulled from a base image so a rebuild produces the same environment, and
# so what a package needs at install time is visible in one place.
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        file \
        pkg-config \
        ca-certificates \
        unzip \
        xz-utils \
        # the webview toolkit the desktop window renders through
        libwebkit2gtk-4.1-dev \
        libgtk-3-dev \
        libayatana-appindicator3-dev \
        librsvg2-dev \
        # the packaging formats a bundle can produce
        fakeroot \
        dpkg-dev \
        desktop-file-utils \
        # what the application calls out to
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# The Tauri CLI, pinned to the same major version the configuration targets.
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none
ENV PATH="/root/.cargo/bin:$PATH"
RUN rustup toolchain install stable --profile minimal \
    && rustup default stable \
    && rustup target add x86_64-unknown-linux-gnu
RUN cargo install tauri-cli --version "^2" --locked

WORKDIR /src
CMD ["bash"]